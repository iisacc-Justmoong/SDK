# Collect source-bearing local targets reachable through ordinary CMake link dependencies.
function(_iiagent_application_interface_collect_targets result initial)
    set(_pending "${initial}")
    set(_visited)
    set(_collected)
    while(_pending)
        list(POP_FRONT _pending _current)
        if(NOT TARGET "${_current}")
            continue()
        endif()
        get_target_property(_alias "${_current}" ALIASED_TARGET)
        if(_alias)
            set(_current "${_alias}")
        endif()
        if(_current IN_LIST _visited)
            continue()
        endif()
        list(APPEND _visited "${_current}")
        get_target_property(_imported "${_current}" IMPORTED)
        if(_imported)
            continue()
        endif()
        get_target_property(_type "${_current}" TYPE)
        if(_type MATCHES "^(EXECUTABLE|STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY|OBJECT_LIBRARY)$")
            list(APPEND _collected "${_current}")
        endif()
        foreach(_property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
            get_target_property(_links "${_current}" "${_property}")
            if(NOT _links)
                continue()
            endif()
            foreach(_link IN LISTS _links)
                if(_link MATCHES "^\\$<(LINK_ONLY|BUILD_INTERFACE):([^>$]+)>$")
                    set(_link "${CMAKE_MATCH_2}")
                endif()
                if(TARGET "${_link}")
                    list(APPEND _pending "${_link}")
                endif()
            endforeach()
        endforeach()
    endwhile()
    set("${result}" "${_collected}" PARENT_SCOPE)
endfunction()

# Attach source-declaration discovery to an application target without registering members individually.
function(iiAgentApplicationInterface_enable_discovery target)
    cmake_parse_arguments(DISCOVERY "" "" "ROOTS" ${ARGN})
    if(NOT TARGET "${target}")
        message(FATAL_ERROR "Unknown application target: ${target}")
    endif()
    get_target_property(_target_type "${target}" TYPE)
    if(NOT _target_type STREQUAL "EXECUTABLE")
        message(FATAL_ERROR "Build discovery must be attached to the final application executable")
    endif()
    if(NOT CMAKE_GENERATOR MATCHES "Ninja|Makefiles")
        message(FATAL_ERROR "Build discovery requires a generator that emits compile_commands.json (Ninja or Makefiles)")
    endif()
    if(CMAKE_CONFIGURATION_TYPES)
        message(FATAL_ERROR "Build discovery currently requires a single-configuration generator")
    endif()
    get_target_property(_already "${target}" IIAGENTAPPLICATIONINTERFACE_DISCOVERY_ENABLED)
    if(_already)
        message(FATAL_ERROR "Build discovery already enabled for ${target}")
    endif()
    if(NOT DISCOVERY_ROOTS)
        set(DISCOVERY_ROOTS "${CMAKE_CURRENT_SOURCE_DIR}")
        set(_add_target_roots TRUE)
    endif()
    find_package(Python3 3.9 REQUIRED COMPONENTS Interpreter)
    set(CMAKE_EXPORT_COMPILE_COMMANDS ON CACHE BOOL "Export compilation commands for build discovery" FORCE)
    _iiagent_application_interface_collect_targets(_source_targets "${target}")
    foreach(_source_target IN LISTS _source_targets)
        set_property(TARGET "${_source_target}" PROPERTY EXPORT_COMPILE_COMMANDS ON)
        if(_add_target_roots)
            get_target_property(_source_dir "${_source_target}" SOURCE_DIR)
            if(_source_dir)
                list(APPEND DISCOVERY_ROOTS "${_source_dir}")
                get_target_property(_source_files "${_source_target}" SOURCES)
                foreach(_source IN LISTS _source_files)
                    if(NOT _source MATCHES "^\\$<")
                        get_filename_component(_absolute_source "${_source}" ABSOLUTE BASE_DIR "${_source_dir}")
                        get_filename_component(_source_parent "${_absolute_source}" DIRECTORY)
                        if(IS_DIRECTORY "${_source_parent}")
                            list(APPEND DISCOVERY_ROOTS "${_source_parent}")
                        endif()
                    endif()
                endforeach()
            endif()
        endif()
    endforeach()
    list(REMOVE_DUPLICATES DISCOVERY_ROOTS)
    set_property(TARGET "${target}" PROPERTY IIAGENTAPPLICATIONINTERFACE_DISCOVERY_ENABLED TRUE)
    set(_generated "${CMAKE_CURRENT_BINARY_DIR}/iiAgentApplicationInterface/${target}/BuildCatalog.cpp")
    set(_arguments --database "${CMAKE_BINARY_DIR}/compile_commands.json" --output "${_generated}")
    foreach(_source_target IN LISTS _source_targets)
        list(APPEND _arguments --target "${_source_target}")
    endforeach()
    foreach(_root IN LISTS DISCOVERY_ROOTS)
        get_filename_component(_absolute_root "${_root}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        list(APPEND _arguments --root "${_absolute_root}")
    endforeach()
    add_custom_target("${target}_iiagent_discovery"
        COMMAND "${Python3_EXECUTABLE}" "${iiAgentApplicationInterface_DISCOVERY_SCRIPT}" ${_arguments}
        BYPRODUCTS "${_generated}"
        COMMENT "Discovering application declarations for ${target}"
        VERBATIM)
    foreach(_source_target IN LISTS _source_targets)
        if(NOT "${_source_target}" STREQUAL "${target}")
            add_dependencies("${target}_iiagent_discovery" "${_source_target}")
        endif()
    endforeach()
    set_source_files_properties("${_generated}" PROPERTIES GENERATED TRUE)
    target_sources("${target}" PRIVATE "${_generated}")
    target_link_libraries("${target}" PRIVATE iiAgentApplicationInterface::iiAgentApplicationInterface)
    add_dependencies("${target}" "${target}_iiagent_discovery")
endfunction()
