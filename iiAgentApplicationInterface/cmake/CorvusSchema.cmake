# A versioned permissive native JSON Schema engine. Its C interface keeps Rust
# implementation types out of our public ABI. Callers can supply a target-native
# package for other platforms through the explicit prefix option.
set(IIAGENTAPPLICATIONINTERFACE_CORVUS_PREFIX "" CACHE PATH "Target-native Corvus JSON Schema package prefix")
set(IIAGENTAPPLICATIONINTERFACE_CORVUS_LIBC "gnu" CACHE STRING "Linux package C library: gnu or musl")
set_property(CACHE IIAGENTAPPLICATIONINTERFACE_CORVUS_LIBC PROPERTY STRINGS gnu musl)
if(IIAGENTAPPLICATIONINTERFACE_CORVUS_PREFIX)
    set(_iiagent_corvus_root "${IIAGENTAPPLICATIONINTERFACE_CORVUS_PREFIX}")
else()
    string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" _iiagent_arch)
    if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
        set(_iiagent_variant "universal2-apple-darwin")
        set(_iiagent_hash "136d538b5ebe117fa6233c224c58cf6ff939149ec041c0c9317bcf4194c1d3aa")
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND _iiagent_arch MATCHES "^(arm64|aarch64|x86_64|amd64)$")
        if(_iiagent_arch MATCHES "^(arm64|aarch64)$")
            set(_iiagent_arch aarch64)
        else()
            set(_iiagent_arch x86_64)
        endif()
        if(NOT IIAGENTAPPLICATIONINTERFACE_CORVUS_LIBC MATCHES "^(gnu|musl)$")
            message(FATAL_ERROR "IIAGENTAPPLICATIONINTERFACE_CORVUS_LIBC must be gnu or musl")
        endif()
        set(_iiagent_variant "${_iiagent_arch}-unknown-linux-${IIAGENTAPPLICATIONINTERFACE_CORVUS_LIBC}")
        if(_iiagent_variant STREQUAL "aarch64-unknown-linux-gnu")
            set(_iiagent_hash "00ad0bce8b1ae0d2c7657de191ea942293ab606bdc5f98f331b018e03b5dff10")
        elseif(_iiagent_variant STREQUAL "aarch64-unknown-linux-musl")
            set(_iiagent_hash "92b6d6ba48fcfcbbedbf2d0bbb337d60e075d6289efd4a86ee7097e939d637ce")
        elseif(_iiagent_variant STREQUAL "x86_64-unknown-linux-gnu")
            set(_iiagent_hash "290ada3bfedaf466b975f6992ff525629e7402669f1d1efbf4c1dd9c164d6a24")
        else()
            set(_iiagent_hash "0830191606e99b1ee8bf3e9dd013c9e44bce19598dfbe45a235a054474e0cd45")
        endif()
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Windows" AND MSVC AND _iiagent_arch MATCHES "^(arm64|aarch64|x86_64|amd64)$")
        if(_iiagent_arch MATCHES "^(arm64|aarch64)$")
            set(_iiagent_variant "aarch64-pc-windows-msvc")
            set(_iiagent_hash "e74eb3822fa0730654045c2cf455a899bef90f90b6f183e60ee6a36416555a94")
        else()
            set(_iiagent_variant "x86_64-pc-windows-msvc")
            set(_iiagent_hash "b7c1e00459dc0018b6986f4bb38e2d4ad70b22d2cde2b6c84b06a8e57fdc70be")
        endif()
    else()
        message(FATAL_ERROR "Provide IIAGENTAPPLICATIONINTERFACE_CORVUS_PREFIX for the target's Corvus package")
    endif()
    if(WIN32)
        set(_iiagent_extension zip)
    else()
        set(_iiagent_extension tar.gz)
    endif()
    set(_iiagent_package "corvus-json-schema-0.1.7-${_iiagent_variant}")
    set(_iiagent_corvus_root "${CMAKE_CURRENT_SOURCE_DIR}/resources/dependencies/${_iiagent_package}")
    if(NOT EXISTS "${_iiagent_corvus_root}/include/corvus_json_schema.hpp")
        include(FetchContent)
        FetchContent_Declare(iiagent_corvus
            URL "https://github.com/corvus-dotnet/Corvus.JsonSchema/releases/download/capi-v0.1.7/${_iiagent_package}.${_iiagent_extension}"
            URL_HASH "SHA256=${_iiagent_hash}"
            SOURCE_DIR "${_iiagent_corvus_root}"
            SOURCE_SUBDIR no-cmake-project
            DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
        FetchContent_MakeAvailable(iiagent_corvus)
    endif()
endif()
find_package(corvus_json_schema 0.1.7 CONFIG REQUIRED
    PATHS "${_iiagent_corvus_root}/lib/cmake/corvus_json_schema" NO_DEFAULT_PATH)
