include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/DawnTarget.cmake")
function(expect system processor architectures wanted)
    iigpu_dawn_target(actual "${system}" "${processor}" "${architectures}")
    if(NOT actual STREQUAL wanted)
        message(FATAL_ERROR "Wrong Dawn target for ${system}/${processor}/${architectures}: ${actual}, expected ${wanted}")
    endif()
endfunction()
expect(Darwin arm64 "" macos-arm64)
expect(Darwin arm64 x86_64 macos-x64)
expect(Windows AMD64 "" windows-x64)
expect(Linux x86_64 "" linux-x64)
expect(Linux aarch64 "" linux-arm64)
expect(Android aarch64 "" unsupported-target)
expect(Darwin arm64 "arm64;x86_64" unsupported-target)
