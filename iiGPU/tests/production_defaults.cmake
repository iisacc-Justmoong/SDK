if(NOT DEFINED SOURCE_ROOT OR NOT DEFINED BINARY_ROOT)
    message(FATAL_ERROR "SOURCE_ROOT and BINARY_ROOT are required")
endif()
set(probe "${BINARY_ROOT}/production-default-probe")
if(EXISTS "${probe}")
    message(FATAL_ERROR "Refusing to overwrite an existing probe: ${probe}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${SOURCE_ROOT}" -B "${probe}"
    -DIIGPU_WEBGPU=OFF RESULT_VARIABLE status OUTPUT_QUIET)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Default configuration failed")
endif()
file(READ "${probe}/CMakeCache.txt" cache)
if(NOT cache MATCHES "BUILD_TESTING:BOOL=ON" OR NOT cache MATCHES "IIGPU_BUILD_EXAMPLES:BOOL=OFF")
    file(REMOVE_RECURSE "${probe}")
    message(FATAL_ERROR "Tests must be enabled and examples opt-in")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${probe}" --target iiGPURetirementTests
    RESULT_VARIABLE tests_status OUTPUT_QUIET ERROR_QUIET)
if(NOT tests_status EQUAL 0)
    file(REMOVE_RECURSE "${probe}")
    message(FATAL_ERROR "Default test target did not build")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${probe}" --target iiGPUAcceleration
    RESULT_VARIABLE example_status OUTPUT_QUIET ERROR_QUIET)
if(example_status EQUAL 0)
    file(REMOVE_RECURSE "${probe}")
    message(FATAL_ERROR "Default build unexpectedly exposes the example target")
endif()
file(REMOVE_RECURSE "${probe}")
