# Select the compiler target, never the host running CMake. Universal builds
# require a deliberately supplied universal Dawn distribution.
function(iigpu_dawn_target result system processor apple_architectures)
    set(os "")
    if(system STREQUAL "Darwin")
        set(os macos)
    elseif(system STREQUAL "Windows")
        set(os windows)
    elseif(system STREQUAL "Linux")
        set(os linux)
    endif()
    if(system STREQUAL "Darwin" AND apple_architectures)
        set(processor "${apple_architectures}")
    endif()
    string(TOLOWER "${processor}" processor)
    set(cpu "")
    if(processor MATCHES "^(arm64|aarch64)$")
        set(cpu arm64)
    elseif(processor MATCHES "^(x86_64|amd64|x64)$")
        set(cpu x64)
    endif()
    if(os AND cpu)
        set(${result} "${os}-${cpu}" PARENT_SCOPE)
    else()
        set(${result} "unsupported-target" PARENT_SCOPE)
    endif()
endfunction()
