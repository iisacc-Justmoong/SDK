#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Input { uint values[]; };
layout(set=0,binding=1,std430) writeonly buffer Output { uint result[]; };
layout(push_constant) uniform Parameters { uint count; uint scale; uint bias; } p;
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i<p.count) result[i]=values[i]*p.scale+p.bias;
}
