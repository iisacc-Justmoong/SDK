      "start_line": 51,
      "end_line": 55,
      "raw": "- build/Testing/Temporary/LastTest.log\n- build/sanitize/Testing/Temporary/LastTest.log\n- build/relocation-report.json\n- build/sanitize/relocation-report.json\n- build/documentation/verify-report.json\n",
      "items": [
        {
          "marker": "-",
          "text": "build/Testing/Temporary/LastTest.log",
          "checked": null
        },
        {
          "marker": "-",
          "text": "build/sanitize/Testing/Temporary/LastTest.log",
