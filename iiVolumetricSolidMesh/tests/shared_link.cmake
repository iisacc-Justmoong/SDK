if(NOT LIBRARY_TYPE STREQUAL "SHARED_LIBRARY")
    message(FATAL_ERROR "SDK target is not a shared library: ${LIBRARY_TYPE}")
endif()
if(NOT EXISTS "${LIBRARY}" OR NOT EXISTS "${IMAGE}")
    message(FATAL_ERROR "The shared library or its test executable is missing")
endif()
get_filename_component(_name "${LIBRARY}" NAME)
if(CMAKE_HOST_APPLE)
    find_program(_inspector otool REQUIRED)
    execute_process(COMMAND "${_inspector}" -L "${IMAGE}"
        OUTPUT_VARIABLE _imports RESULT_VARIABLE _status)
elseif(CMAKE_HOST_UNIX)
    find_program(_inspector readelf REQUIRED)
    execute_process(COMMAND "${_inspector}" -d "${IMAGE}"
        OUTPUT_VARIABLE _imports RESULT_VARIABLE _status)
else()
    get_filename_component(_directory "${LIBRARY}" DIRECTORY)
    file(GET_RUNTIME_DEPENDENCIES EXECUTABLES "${IMAGE}" DIRECTORIES "${_directory}"
        RESOLVED_DEPENDENCIES_VAR _resolved UNRESOLVED_DEPENDENCIES_VAR _unresolved)
    file(REAL_PATH "${LIBRARY}" _wanted)
    foreach(_dependency IN LISTS _resolved)
        file(REAL_PATH "${_dependency}" _actual)
        if(_wanted STREQUAL _actual)
            return()
        endif()
    endforeach()
    message(FATAL_ERROR "The executable does not import ${LIBRARY}; unresolved: ${_unresolved}")
endif()
string(FIND "${_imports}" "${_name}" _index)
if(NOT _status EQUAL 0 OR _index EQUAL -1)
    message(FATAL_ERROR "The executable does not import ${_name}: ${_imports}")
endif()
