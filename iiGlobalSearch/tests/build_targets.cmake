if(NOT DEFINED BUILD_DIR OR NOT DEFINED EXAMPLES OR NOT DEFINED BENCHMARKS)
    message(FATAL_ERROR "BUILD_DIR, EXAMPLES and BENCHMARKS are required")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${BUILD_DIR}" --target help
    RESULT_VARIABLE result OUTPUT_VARIABLE targets ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Unable to inspect build targets: ${error}")
endif()
foreach(pair "iiGlobalSearchExample;${EXAMPLES}" "iiGlobalSearchBenchmark;${BENCHMARKS}")
    list(GET pair 0 target)
    list(GET pair 1 expected)
    if(targets MATCHES "(^|[ \t\r\n])${target}([: \t\r\n]|$)")
        set(found ON)
    else()
        set(found OFF)
    endif()
    if(NOT found STREQUAL expected)
        message(FATAL_ERROR "${target} availability ${found} does not match ${expected}")
    endif()
endforeach()
