@PACKAGE_INIT@
if(EMSCRIPTEN AND @BUILD_SHARED_LIBS@)
    # Emscripten's CMake toolchain defaults to static libraries even when the
    # installed SDK was deliberately built as a WebAssembly side module.
    set_property(GLOBAL PROPERTY TARGET_SUPPORTS_SHARED_LIBS TRUE)
endif()
include(CMakeFindDependencyMacro)
find_dependency(iiSDKCore 0.18 CONFIG COMPONENTS Runtime Values)
include("${CMAKE_CURRENT_LIST_DIR}/iiGlobalSearchAnswerTargets.cmake")
set(iiGlobalSearch_Answer_FOUND TRUE)
if(NOT iiGlobalSearch_FIND_COMPONENTS OR "Local" IN_LIST iiGlobalSearch_FIND_COMPONENTS)
    find_dependency(iiJson CONFIG)
    find_dependency(iiFileProviderCatalog 0.7.3 CONFIG)
    if(NOT iiFileProviderCatalog_HAS_FILE_SEARCH_INDEX OR NOT iiFileProviderCatalog_HAS_FILE_SEARCH_PAGE OR NOT iiFileProviderCatalog_HAS_PACKAGES)
        set(iiGlobalSearch_FOUND FALSE)
        set(iiGlobalSearch_NOT_FOUND_MESSAGE "iiFileProviderCatalog must provide paged FileSearchIndex and package support")
        return()
    endif()
    find_dependency(iiFileProviderNative 0.7 CONFIG)
    find_dependency(iiSocietyContainer CONFIG COMPONENTS FileTree)
    include("${CMAKE_CURRENT_LIST_DIR}/iiGlobalSearchTargets.cmake")
    set(iiGlobalSearch_Local_FOUND TRUE)
endif()
if("Web" IN_LIST iiGlobalSearch_FIND_COMPONENTS)
    find_dependency(iiJson CONFIG)
    find_dependency(iiFileProviderNative 0.7 CONFIG)
    find_dependency(iiNetwork 0.5 CONFIG)
    find_dependency(LibXml2 2.9)
    find_dependency(CURL 7.62)
    include("${CMAKE_CURRENT_LIST_DIR}/iiGlobalSearchWebTargets.cmake")
    set(iiGlobalSearch_Web_FOUND TRUE)
endif()
check_required_components(iiGlobalSearch)
